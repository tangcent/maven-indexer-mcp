{
  "name": "maven-indexer-mcp",
  "version": "1.1.0",
  "description": "MCP server for indexing the local Maven/Gradle artifact cache",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "maven-indexer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/bundle-package.mjs packages/mcp src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "better-sqlite3": "^12.5.0",
    "chokidar": "^5.0.0",
    "semver": "^7.7.3",
    "xml2js": "^0.6.2",
    "yauzl": "^3.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@maven-indexer/engine": "1.1.0"
  }
}
