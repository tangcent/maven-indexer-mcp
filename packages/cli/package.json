{
  "name": "maven-indexer-cli",
  "version": "1.1.0",
  "description": "CLI tool for querying the local Maven/Gradle artifact index",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "maven-indexer-cli": "dist/cli.js"
  },
  "files": [
